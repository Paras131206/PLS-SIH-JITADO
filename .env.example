# Environment configuration for APAAR-SDMS

# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=apaar_sdms
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/apaar_sdms
SQLITE_FALLBACK_URL=sqlite:///./apaar_sdms.db

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Security and Auth
SECRET_KEY=super-secret-development-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AICTE Trust & DIDs
AICTE_DID=did:web:aicte.gov.in

# App runtime
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
